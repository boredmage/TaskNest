# Server
PORT=8787
# "production" on the VPS (deploy.sh insists on it)
NODE_ENV=development
# Public base URL clients use to reach this server (used for avatar URLs).
# On a physical device this must be your machine's LAN IP, not localhost.
PUBLIC_URL=http://localhost:8787

# Postgres. Local dev: `bun run db:up` starts it on POSTGRES_HOST_PORT and the
# API connects via DATABASE_URL. Inside Docker (deploy.sh) DATABASE_URL is
# overridden to the "db" container, so only the POSTGRES_* values matter there.
POSTGRES_USER=tasknest
POSTGRES_PASSWORD=tasknest
POSTGRES_DB=tasknest
# Host port for Postgres. 5434 locally; use 5435 on the shared VPS (cowrie
# has 5434, p2p-manager 5433).
POSTGRES_HOST_PORT=5434
# Docker volume holding the database. Leave the default on the VPS. A local
# checkout from before the compose rewrite has its data in
# server_tasknest_pgdata — set that here to keep it.
PGDATA_VOLUME=tasknest_pgdata
DATABASE_URL=postgres://tasknest:tasknest@localhost:5434/tasknest
# Host port the API container is published on (localhost only)
API_PORT=8787

# Auth
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Where uploaded avatars are stored on disk (local dev fallback)
UPLOADS_DIR=./uploads

# Cloudflare R2 (optional). Set all five to store avatars in R2 instead of
# UPLOADS_DIR. Cloudflare dashboard > R2 > Manage API tokens for the keys;
# the account id is on the R2 overview page. R2_PUBLIC_URL is the bucket's
# public URL (Settings > Public access: the r2.dev subdomain or a custom
# domain), without a trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tasknest
R2_PUBLIC_URL=

# Optional: Expo push access token (only needed if you enabled
# "Enhanced Security for Push Notifications" on expo.dev)
EXPO_ACCESS_TOKEN=

# Optional: Resend API key for password-reset emails. When empty, OTP codes
# are printed to the server log instead of emailed.
RESEND_API_KEY=
MAIL_FROM="TaskNest <no-reply@example.com>"

# How often (seconds) to sweep for overdue todos
OVERDUE_SWEEP_INTERVAL_SECONDS=300
