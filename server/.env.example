# Server
PORT=8787
# Public base URL clients use to reach this server (used for avatar URLs).
# On a physical device this must be your machine's LAN IP, not localhost.
PUBLIC_URL=http://localhost:8787

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://tasknest:tasknest@localhost:5434/tasknest

# Auth
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Where uploaded avatars are stored on disk
UPLOADS_DIR=./uploads

# Optional: Expo push access token (only needed if you enabled
# "Enhanced Security for Push Notifications" on expo.dev)
EXPO_ACCESS_TOKEN=

# Optional: Resend API key for password-reset emails. When empty, OTP codes
# are printed to the server log instead of emailed.
RESEND_API_KEY=
MAIL_FROM="TaskNest <no-reply@example.com>"

# How often (seconds) to sweep for overdue todos
OVERDUE_SWEEP_INTERVAL_SECONDS=300
