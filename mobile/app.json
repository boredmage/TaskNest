{
  "expo": {
    "scheme": "tasknest",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "name": "TaskNest",
    "slug": "tasknest",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#72d000",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification_icon.png",
          "color": "#72d000",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qudusayo.tasknest",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qudusayo.tasknest",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df385772-ead4-441c-91d2-339a03084c37"
      }
    },
    "owner": "qudusayo"
  }
}
